# Copy to .env and fill in what your setup needs. Shell variables win over this file.
# Nothing here is secret by default; HARNESS2_JUDGE_API_KEY is the one to keep out of git.

# --- executor and improver models -------------------------------------------------------
# provider/model, exactly as your gateway expects it.
HARNESS2_SOLVER_MODEL=
HARNESS2_IMPROVER_MODEL=
# Reasoning effort for rollouts: off | minimal | low | medium | high | xhigh | max
HARNESS2_SOLVER_EFFORT=high

# --- per-substrate executor overrides ---------------------------------------------------
# Default to HARNESS2_SOLVER_MODEL. Codex CLI and DeepSeek Harness accept a bare model
# id; dsh resolves that against its `deepseek-official` API-key route.
HARNESS2_CODEX_MODEL=
HARNESS2_PI_MODEL=
HARNESS2_DSH_MODEL=

# --- CLI locations ----------------------------------------------------------------------
# Default to PATH, then to the copy `harness2-setup` installs under dependencies/.
HARNESS2_PI_BIN=
HARNESS2_DSH_BIN=
# A dedicated Pi agent directory (saved logins). Leave unset to isolate each rollout.
HARNESS2_PI_AGENT_DIR=
# An extra dsh overlay applied after the one harness2 writes (gateways, profile rows).
HARNESS2_DSH_PATCH=
# dsh approval mode. danger-full-access needs no approval channel, which headless runs lack.
HARNESS2_DSH_PERMISSION_MODE=danger-full-access

# --- improver channel -------------------------------------------------------------------
# opencode | claude_cli | pi
HARNESS2_IMPROVER_CHANNEL=opencode

# --- judging ----------------------------------------------------------------------------
# An OpenAI-compatible endpoint. JobBench and the custom benchmark grade here.
HARNESS2_JUDGE_MODEL=
HARNESS2_JUDGE_BASE_URL=
HARNESS2_JUDGE_API_KEY=
# Extra HTTP headers as a JSON object, e.g. {"x-opencode-session": "..."}.
# A gateway that routes on a header needs this; OpenCode's is filled in automatically.
HARNESS2_JUDGE_HEADERS=

# --- Google Vertex AI (the upstream default) --------------------------------------------
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# --- Codex CLI executor ----------------------------------------------------------------
HARNESS2_CODEX_BASE_URL=
HARNESS2_CODEX_API_KEY=

# --- run state --------------------------------------------------------------------------
# Where runs, summaries and libraries are written.
HARNESS2_RUNS_DIR=
# Per-rollout workspaces for the CLI substrates. Must NOT be inside a git checkout:
# the agents resolve their project root by walking up to .git.
HARNESS2_SCRATCH=

# --- custom benchmark -------------------------------------------------------------------
# A directory of <area>/<task>/TASK.md assignments.
HARNESS2_CUSTOM_TASKS=
# A harness tree to start from, typically one written by `harness2-export`.
HARNESS2_CUSTOM_SEED=
